# ================================================================
# ASSESSMENT · PLANEACIÓN ESTRATÉGICA · Variables de Entorno
# ================================================================
# 1. Copia este archivo: cp .env.example .env
# 2. Copia al dashboard: cp .env.example web/.env.local
# 3. Llena los valores reales en .env (nunca subas .env a git)
# ================================================================

# ─────────────────────────────────────────────────────────────────
# AGENTE 2: Anthropic Claude Sonnet (OBLIGATORIO)
# Obtén tu key en: https://console.anthropic.com/
# ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-TU_KEY_AQUI
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-20250514
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─────────────────────────────────────────────────────────────────
# AGENTE 1: Google Gemini Flash (Multi-LLM - proveedor distinto)
# Obtén tu key GRATIS en: https://aistudio.google.com/apikey
# Si no la configuras → el sistema usa Claude Haiku como fallback
# ─────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza_TU_KEY_AQUI
GEMINI_API_KEY=AIza_TU_KEY_AQUI
GOOGLE_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────────────────────────
# MYSQL (XAMPP por defecto — sin password en instalación estándar)
# ─────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=assessment_db

# ─────────────────────────────────────────────────────────────────
# NEXT.JS
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
# Ruta absoluta a la carpeta assessment/ (padre de web/).
# Si se deja vacío, se auto-detecta desde cwd/..
ASSESSMENT_ROOT=

# ─────────────────────────────────────────────────────────────────
# WHATSAPP (notificaciones ejecutivas)
# API compatible con WhatsApp Business / Baileys / etc.
# ─────────────────────────────────────────────────────────────────
WHATSAPP_URL=http://TU_SERVIDOR:3001/send
WHATSAPP_NUMBER=502XXXXXXXX

# ─────────────────────────────────────────────────────────────────
# OPENAI (infografías con gpt-image-2 — opcional)
# Obtén tu key en: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-TU_KEY_AQUI
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_CHAT_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────
# MINIMAX (Text-to-Speech — opcional)
# Regístrate en: https://api.minimax.chat/
# ─────────────────────────────────────────────────────────────────
MINIMAX_API_KEY=TU_MINIMAX_KEY_AQUI
MINIMAX_GROUP_ID=TU_GROUP_ID_AQUI
MINIMAX_VOICE=Wise_Woman

# ─────────────────────────────────────────────────────────────────
# OLLAMA (modelos locales o remotos — opcional)
# Instala: https://ollama.com → luego: ollama pull deepseek-r1:7b
# ─────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# ─────────────────────────────────────────────────────────────────
# GAMMA.APP (presentaciones ejecutivas — opcional)
# Obtén tu key en: https://gamma.app/developers
# ─────────────────────────────────────────────────────────────────
GAMMA_API_KEY=TU_GAMMA_KEY_AQUI

# ─────────────────────────────────────────────────────────────────
# PIPELINE
# ─────────────────────────────────────────────────────────────────
DATA_DIR=./data
PYTHON_BIN=python3

# ─────────────────────────────────────────────────────────────────
# CHAT (proveedor por defecto — se puede cambiar desde la UI)
# Opciones: claude | ollama | gemini | openai
# ─────────────────────────────────────────────────────────────────
CHAT_PROVIDER=claude
